# Copy to storage/app/private/supplier-trial/connection.env; never overwrite existing credentials.
# This file does not enable transport. supplier:trial is offline unless --download is explicit.
SUPPLIER_TRIAL_DATABASE=usbstock_dev
SUPPLIER_FTP_PROTOCOL=ftp
SUPPLIER_FTP_PORT=21
SUPPLIER_FTP_PATH=/FTP/Existencias-ftp-precio.csv
SUPPLIER_FTP_HOST=
SUPPLIER_FTP_USER=
SUPPLIER_FTP_PASSWORD=
# Enable only after explicit acceptance of unencrypted FTP for the trial.
SUPPLIER_TRIAL_ALLOW_PLAINTEXT=false
